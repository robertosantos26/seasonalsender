+def display_attachment_name(stored_filename, config):
+    """Gera o nome do arquivo mostrado para quem recebe o email (ex: 'server_cv.pdf'
+    -> 'Roberto_server_cv.pdf'), sem alterar o nome interno usado para localizar o
+    arquivo na tabela attachments."""
+    if not stored_filename:
+        return stored_filename
+    name = (config.get("name") or "").strip()
+    if not name:
+        return stored_filename
+    safe_name = "".join(c for c in name if c.isalnum() or c in (" ", "_", "-")).strip()
+    safe_name = safe_name.replace(" ", "_")
+    if not safe_name:
+        return stored_filename
+    base, ext = os.path.splitext(stored_filename)
+    return f"{safe_name}_{base}{ext}"
